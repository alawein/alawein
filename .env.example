# GitHub dashboard generator token (preferred)
DASHBOARD_GITHUB_TOKEN=ghp_your_token_here

# Backward-compatible fallback token names
# GITHUB_DASHBOARD_TOKEN=ghp_your_token_here
# GITHUB_TOKEN=ghp_your_token_here

# Notion Projects sync uses process-injected credentials, not env files.
# Configure NOTION_TOKEN and NOTION_DB_ID as 1Password secret references.
# Canonical property names: Domain, Category, Tags, Name, Description, Repo.
# Local validation, sync, and verification:
#   op run -- pwsh -NoProfile -File scripts/notion/run-notion-local.ps1

# OpenRouter (scripts/ops/openrouter_route.py) — key stays gitignored
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: ~/.openrouter.env or workspace ../.env.local (see config/model-routing.yaml)
