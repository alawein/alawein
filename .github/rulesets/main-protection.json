{
  "_comment": "Recorded configuration of alawein/alawein ruleset 10399573, verified 2026-09-10. Reconcile that existing ruleset only under explicit authorization; do not import as an additional ruleset. Remove this documentation-only _comment field from any API request. Native effective controls remain authoritative.",
  "name": "Branch Protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main", "refs/heads/master"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          { "context": "validate-contract" },
          { "context": "test-scripts" },
          { "context": "lint-managed-markdown" },
          { "context": "GitHub Baseline Audit" },
          { "context": "Gitleaks" }
        ]
      }
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "copilot_code_review",
      "parameters": {
        "review_on_push": false,
        "review_draft_pull_requests": false
      }
    }
  ],
  "bypass_actors": []
}
