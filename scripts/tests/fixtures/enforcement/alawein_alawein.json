  "ruleset_details": [
    {
      "id": 10399573,
      "name": "Branch Protection",
      "target": "branch",
      "source_type": "Repository",
      "source": "alawein/alawein",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": [
            "refs/heads/main",
            "refs/heads/master"
          ]
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": true,
            "required_status_checks": [
              {
                "context": "validate-contract"
              },
              {
                "context": "test-scripts"
              },
              {
                "context": "lint-managed-markdown"
              },
              {
                "context": "GitHub Baseline Audit"
              },
              {
                "context": "Gitleaks"
              }
            ]
          }
        },
        {
          "type": "required_linear_history"
        },
        {
          "type": "required_signatures"
        },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": true,
            "required_reviewers": [],
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": true,
            "require_extra_approval_for_unattributed_changes": true,
            "allowed_merge_methods": [
              "squash"
            ]
          }
        },
        {
          "type": "copilot_code_review",
          "parameters": {
            "review_on_push": false,
            "review_draft_pull_requests": false
          }
        }
      ],
      "node_id": "RRS_lACqUmVwb3NpdG9yec5BLmcOzgCer1U",
      "created_at": "2025-11-25T04:34:30.539-08:00",
