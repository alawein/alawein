# Reference draft only (Phase 3, step 14). Not yet wired into
# scripts/kernel/render.py's _MANAGED_SPECS: catalog/kernel.yaml's
# workflow_pin_sha is still unset, and rendering this with no canonical pin
# would ship an unpinned reusable-workflow reference fleet-wide. See
# docs/internal/kernel-parity-2026-09-08.md "Step 14" and kernel-spec.md
# open items.
#
# Intent once the pin lands: run both engines side by side, repo-drift
# warn-only, until one clean wave (step 15) justifies flipping repo-drift to
# blocking and dropping the workspace-batch step.
name: drift

on:
  pull_request:
  push:
    branches: [main]

jobs:
  workspace-batch-drift:
    name: drift (workspace-batch, blocking)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Run workspace-batch drift check
        run: |
          python -m pip install workspace-batch==${workspace_batch_pin}
          workspace-batch drift check --target . --reporter github

  repo-drift-warn-only:
    name: drift (repo-drift, warn-only)
    runs-on: ubuntu-latest
    continue-on-error: true
    steps:
      - uses: actions/checkout@v4
      - name: Run repo-drift check
        run: |
          python -m pip install "repo-drift @ git+https://github.com/alawein/repo-drift@${repo_drift_release_sha}"
          repo-drift check --target . --reporter github
