name: drift

# ADR 0003: repo-drift is the blocking conformance engine. The live required
# check context name is `drift` (job name below). workspace-batch drift was
# removed; do not reintroduce a second writer for this context.

on:
  pull_request:
  push:
    branches: [main]

jobs:
  drift:
    name: drift
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
      - name: Run repo-drift check
        run: |
          python -m pip install "repo-drift @ git+https://github.com/alawein/repo-drift@${repo_drift_release_sha}"
          repo-drift check --target . --reporter github
